<resources>
    <style name="RadioPanelAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/radioText</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="backgroundTint">?attr/radioElevated</item>
        <item name="strokeColor">?attr/radioOutline</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">@dimen/radio_corner_button</item>
    </style>
    <style name="RadioRecordingAction" parent="RadioPanelAction">
        <item name="android:textColor">#FF757B</item>
        <item name="strokeColor">#704148</item>
        <item name="backgroundTint">#2D202A</item>
    </style>
</resources>
