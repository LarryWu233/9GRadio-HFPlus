<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/radioMain">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/radioSurface"
        app:elevation="0dp"
        android:stateListAnimator="@null"
        app:statusBarForeground="?attr/radioSurface"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/radioSurface"
            app:titleTextColor="#CCFFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/statusIndicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_disconnected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="156dp" android:singleLine="true" android:ellipsize="end"
                    android:text="Not Connected"
                    android:textColor="?attr/radioSecondary"
                    android:textSize="12sp" />

            <!-- Manual listening switch -->
            <TextView
                android:id="@+id/tvSquelchStatus"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="OPEN"
                android:textSize="11sp"
                android:textColor="#00FF88"
                android:fontFamily="monospace"
                android:minWidth="64dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                <ProgressBar
                    android:id="@+id/progressConnect"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone" />
                <ImageButton android:id="@+id/btnToolbarSettings"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@drawable/ic_module_settings" android:tint="#AFC5D2"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp" android:contentDescription="设备与设置"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content: fills space above the bottom sheet peek -->
    <eightbitlab.com.blurview.BlurTarget android:id="@+id/panelBlurTarget"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar: Demod, Rate, Signal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="?attr/radioSurface"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDemodMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:singleLine="true" android:maxWidth="80dp" android:ellipsize="end"
                android:text="NFM"
                android:textColor="?attr/radioLink"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="#22004488"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"/>

            <View android:layout_width="12dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tvSampleRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:singleLine="true" android:maxWidth="94dp" android:ellipsize="end"
                android:text="2.048 MS/s"
                android:textColor="?attr/radioSecondary"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <!-- Signal meter -->
            <ProgressBar
                android:id="@+id/signalMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="56dp"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00FF44"
                android:progressBackgroundTint="#224400"/>

            <TextView
                android:id="@+id/tvSignalDb"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:text="-120 dBFS"
                android:textColor="?attr/radioSecondary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="end" android:singleLine="true" android:maxLines="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Frequency view -->
        <com.radiosport.ninegradio.ui.FrequencyView
            android:id="@+id/frequencyView"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="?attr/radioMain"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:gravity="center_vertical" android:background="?attr/radioSurface" android:orientation="horizontal">
        <TextView android:id="@+id/tvBandContext"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:singleLine="true" android:ellipsize="end"
            android:gravity="center_vertical" android:paddingHorizontal="12dp"
            android:textColor="?attr/radioSecondary" android:textSize="12sp" android:background="?attr/radioSurface"/>
        <TextView android:id="@+id/btnGraphGesture" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="10dp"
            android:text="拖动调谐 ▾" android:textColor="?attr/radioLink" android:textSize="12sp"
            android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Spectrum view -->
        <com.radiosport.ninegradio.ui.SpectrumView
            android:id="@+id/spectrumView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="?attr/radioMain"/>

        <LinearLayout android:id="@+id/plotTuningBar" android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/radioSurface">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/btnPlotZoomOut" style="@style/RadioCompactButton"
                    android:layout_width="40dp" android:layout_height="48dp" android:text="−" android:contentDescription="扩大显示宽度"/>
                <com.radiosport.ninegradio.ui.RadioWidthReadout android:id="@+id/tvPlotZoom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                    android:gravity="center" android:textColor="?attr/radioSecondary" android:textSize="11sp" android:maxLines="2"
                    android:clickable="true" android:focusable="true" android:contentDescription="显示宽度，恢复全宽"/>
                <Button android:id="@+id/btnPlotZoomIn" style="@style/RadioCompactButton"
                    android:layout_width="40dp" android:layout_height="48dp" android:text="+" android:contentDescription="缩小显示宽度"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="28dp" android:background="?attr/radioOutline"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/btnStepDown" style="@style/RadioCompactButton"
                    android:layout_width="40dp" android:layout_height="48dp" android:text="−" android:contentDescription="减小 Step"/>
                <com.radiosport.ninegradio.ui.RadioWidthReadout android:id="@+id/tvTuningStep" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                    android:gravity="center" android:textColor="?attr/radioSecondary" android:textSize="11sp" android:maxLines="2"/>
                <Button android:id="@+id/btnStepUp" style="@style/RadioCompactButton"
                    android:layout_width="40dp" android:layout_height="48dp" android:text="+" android:contentDescription="增大 Step"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Waterfall view: takes remaining space above the bottom sheet peek -->
        <com.radiosport.ninegradio.ui.WaterfallView
            android:id="@+id/waterfallView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"/>

    </LinearLayout>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Controls Bottom Sheet
         The direct child is a plain LinearLayout (not NestedScrollView) so the
         drag handle and TabLayout sit OUTSIDE the scrollable region and therefore
         never scroll out of view.  Only the ViewPager2 content (inside the inner
         NestedScrollView) scrolls.

         BottomSheetBehavior works on any View as its direct child; it cooperates
         with NestedScrolling by intercepting scroll events that bubble up from the
         inner NestedScrollView through the LinearLayout.

         peekHeight = drag handle (12dp total) + TabLayout (44dp) + nav-bar inset.
         This is identical to before — the tab bar is always the topmost visible
         element when the sheet is collapsed. -->
    <FrameLayout
        android:id="@+id/controlsBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/control_panel_surface"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="100dp"
        app:behavior_hideable="false">

        <!-- Only the edge is translucent; controls are drawn sharply above it. -->
        <eightbitlab.com.blurview.BlurView android:id="@+id/panelEdgeBlur"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:importantForAccessibility="no" android:clickable="false"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Tab bar — always visible, never scrolls away -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/controlTabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            app:tabMode="scrollable"
            app:tabGravity="center"
            app:tabMinWidth="48dp"
            app:tabTextColor="#667788"
            app:tabSelectedTextColor="?attr/radioLink"
            app:tabIndicatorColor="?attr/radioLink"
            app:tabIndicatorHeight="3dp"
            app:tabIconTint="@color/module_tab_icon"
            app:tabTextAppearance="@android:style/TextAppearance.Small"/>

        <!-- Scrollable content region — only this part scrolls -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/controlsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/radioSurface"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Paged tab content -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/controlViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- No static bottom spacer here: nav-bar clearance is added
                     dynamically as controlsScrollView's paddingBottom in
                     MainActivity#applyExpandedOffset (expandedOffset +
                     navBarHeightPx). A fixed spacer stacked on top of that
                     dynamic padding would double the trailing clearance,
                     letting the sheet scroll past the last real control into
                     empty, unpopulated space. Keep the ViewPager2 as this
                     container's last child so max-scroll always lands
                     exactly where the last control comes into view. -->

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="12dp"
            android:background="@drawable/control_panel_edge" android:importantForAccessibility="no"
            android:clickable="false" android:focusable="false"/>
    </FrameLayout>

    <com.radiosport.ninegradio.ui.PanelToggleView android:id="@+id/sheetToggle"
        android:layout_width="48dp" android:layout_height="32dp"
        android:contentDescription="控制面板" android:clickable="true" android:focusable="true"
        android:elevation="12dp" android:background="@android:color/transparent"
        android:translationY="-2dp"
        app:layout_anchor="@id/controlsBottomSheet" app:layout_anchorGravity="top|center_horizontal"
        android:layout_gravity="center"/>

    <!-- FABs -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBookmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="160dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_bookmark"
        app:backgroundTint="#FFAA00"
        app:fabSize="mini"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="210dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_scan"
        app:backgroundTint="#44FF88"
        app:fabSize="mini"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
