<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/radioMain">

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:background="?attr/radioSurface" android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <TextView android:id="@+id/tvTotalSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Total: 0 MB  (0 files)" android:textColor="?attr/radioSecondary"
            android:textSize="13sp"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/standaloneRecordingPlayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="10dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecordings"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>
