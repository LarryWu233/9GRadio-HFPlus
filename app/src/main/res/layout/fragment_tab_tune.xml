<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 0 – TUNE: tuning dial + step selector + band presets -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/radio_space_lg"
    android:paddingTop="@dimen/radio_space_sm"
    android:paddingBottom="@dimen/radio_space_lg">

    <com.radiosport.ninegradio.ui.SpringTunerView
        android:id="@+id/springTuner" android:layout_width="match_parent"
        android:layout_height="64dp" android:layout_marginBottom="@dimen/radio_space_sm"/>
    <!-- Tuning dial: horizontal 3D film-strip, swipe left/right to tune -->
    <com.radiosport.ninegradio.ui.TuningDialView
        android:id="@+id/tuningDial"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginVertical="4dp"/>

    <TextView android:id="@+id/tvTuneFrequency" android:visibility="gone" android:layout_width="match_parent"
        android:layout_height="32dp" android:gravity="center" android:text="— Hz"
        android:textColor="?attr/radioSecondary" android:textSize="14sp" android:fontFamily="monospace"/>
    <com.radiosport.ninegradio.ui.SegmentedSelectorView android:id="@+id/tuningParameterSelector" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
    <LinearLayout android:id="@+id/stepParameter" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">

    <!-- Step size quick-select chips -->
    <TextView android:textAppearance="@style/TextAppearance.Radio.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step"
        android:visibility="gone"
        android:textColor="?attr/radioLink"
        android:textSize="14sp"
        android:textAllCaps="true"
        android:letterSpacing="0.01"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"/>

        <com.google.android.material.chip.ChipGroup android:visibility="gone"
            android:id="@+id/chipGroupStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"/>


    <com.radiosport.ninegradio.ui.TuningDialView android:id="@+id/stepPicker"
        android:layout_width="match_parent" android:layout_height="80dp"/>
    </LinearLayout>

    <!-- Coarse / Fine toggle -->
    <LinearLayout android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fine Tune"
                android:textColor="?attr/radioSecondary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvFineTuneSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Long-press dial, or toggle here"
                android:textColor="?attr/radioMuted"
                android:textSize="10sp"/>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFineTune"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/bandwidthParameter" android:visibility="gone" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" >
    <!-- Protocol Filter / IF Bandwidth -->
    <TextView android:textAppearance="@style/TextAppearance.Radio.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/receive_filter"
        android:visibility="gone"
        android:textColor="?attr/radioLink" android:textSize="14sp" android:textAllCaps="true"
        android:letterSpacing="0.01" android:layout_marginBottom="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="BW" android:textColor="?attr/radioSecondary" android:textSize="14sp"/>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIfBandwidth"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0" android:valueTo="29" android:value="14"
            android:stepSize="1"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
        <TextView android:id="@+id/tvIfBandwidthValue"
            android:layout_width="110dp" android:layout_height="wrap_content"
            android:text="Auto" android:textColor="?attr/radioLink" android:textSize="12sp"
            android:gravity="end" android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnBandwidthNarrow" style="@style/RadioCompactButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="−" android:textSize="22sp" android:contentDescription="收窄带宽"/>
        <Button android:id="@+id/btnAutoBandwidth" style="@style/RadioCompactButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="Auto"/>
        <Button android:id="@+id/btnBandwidthWide" style="@style/RadioCompactButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="+" android:textSize="22sp" android:contentDescription="放宽带宽"/>
    </LinearLayout>
    </LinearLayout><!-- bandwidthParameter -->

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="?attr/radioOutline" android:layout_marginVertical="12dp"/>


    <!-- Band presets -->
    <TextView android:textAppearance="@style/TextAppearance.Radio.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="频段"
        android:textColor="?attr/radioLink"
        android:textSize="14sp"
        android:textAllCaps="true"
        android:letterSpacing="0.01"
        android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/btnBandPresets" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical" android:text="频段预设  ›"
        android:textSize="14sp" android:textColor="?attr/radioSecondary" android:background="?attr/selectableItemBackground"
        android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/btnMyBookmarks" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical" android:text="我的收藏  ›"
        android:textSize="14sp" android:textColor="?attr/radioSecondary" android:background="?attr/selectableItemBackground"
        android:clickable="true" android:focusable="true"/>
    <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupBands"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>

    <!-- Legacy snap binding -->
    <LinearLayout android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snap to Channel Grid"
                android:textColor="?attr/radioSecondary"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-align to band channel spacing"
                android:textColor="?attr/radioMuted"
                android:textSize="10sp"/>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSnapChannel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"/>
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAutoDemod"
        android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/auto_demod"/>
    <Button style="@style/RadioCompactButton" android:id="@+id/btnRegionalRecommendations" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="@string/region_recommendations"/>
    <Button style="@style/RadioCompactButton" android:visibility="gone" android:id="@+id/btnEtmScan" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="@string/etm_scan"/>
</LinearLayout>

</ScrollView>
