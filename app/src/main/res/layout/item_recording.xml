<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/compact_table_row" android:padding="8dp" android:gravity="center_vertical" android:layout_marginBottom="4dp" android:minHeight="72dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/tvRecName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="recording.iq" android:textColor="?attr/radioText" android:textSize="12sp" android:fontFamily="monospace" android:singleLine="true" android:ellipsize="middle" />
    <TextView android:id="@+id/tvRecInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="100.000 MHz  NFM  2048 kS/s" android:textColor="#88B4BC" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
      <TextView android:id="@+id/tvRecDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="[IQ] 2024-01-01 12:00" android:textColor="?attr/radioSecondary" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" />
      <TextView android:id="@+id/tvRecDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—:—" android:textColor="?attr/radioText" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginHorizontal="8dp"/>
      <TextView android:id="@+id/tvRecSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12.5 MB" android:textColor="#FFAA00" android:textSize="10sp" android:fontFamily="monospace" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
  </LinearLayout>
  <ImageButton android:id="@+id/btnRecPlay" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_media_play" android:background="?selectableItemBackgroundBorderless" android:tint="#44FF88" android:layout_marginStart="4dp" android:padding="9dp" android:contentDescription="播放" />
  <ImageButton android:id="@+id/btnRecShare" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_share" android:background="?selectableItemBackgroundBorderless" android:tint="?attr/radioLink" android:layout_marginStart="4dp" android:padding="9dp" android:contentDescription="分享" />
  <ImageButton android:id="@+id/btnRecDelete" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_delete" android:background="?selectableItemBackgroundBorderless" android:tint="#FF4444" android:layout_marginStart="4dp" android:padding="9dp" android:contentDescription="删除" />
</LinearLayout>