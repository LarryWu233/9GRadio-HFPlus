<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference android:key="receiver_controls_hint" android:title="@string/receiver_controls_location"
        android:summary="@string/receiver_controls_location_hint" android:selectable="false" />

    <!-- ─── RF / Tuner ─────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="界面与工具">
        <ListPreference android:key="pref_ui_theme" android:title="界面配色" android:defaultValue="classic" app:useSimpleSummaryProvider="true"/>
        <Preference android:key="pref_modules" android:title="菜单模块" android:summary="排序与显示"/>
        <SwitchPreferenceCompat android:key="pref_reverse_tuning" android:title="反向调谐" android:defaultValue="false"/>
        <Preference android:key="pref_device_info" android:title="设备信息"/>
        <Preference android:key="pref_bookmarks" android:title="收藏" android:icon="@drawable/ic_bookmark_outline"/>
        <Preference android:key="pref_diagnostics" android:title="诊断面板"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="射频与接收机" android:key="cat_rf">

        <ListPreference
            android:key="pref_sample_rate"
            android:title="默认 IQ 采样率"
            android:summary="IQ 输入采样带宽"
            android:defaultValue="1920000"
            android:dialogTitle="选择 IQ 采样率"
            android:entries="@array/sample_rate_entries"
            android:entryValues="@array/sample_rate_values"/>

        <SeekBarPreference
            android:key="pref_ppm"
            android:title="PPM 校正"
            android:summary="校正接收机频率误差（TCXO 通常接近 0）"
            android:defaultValue="0"
            app:min="-50"
            android:max="50"
            app:showSeekBarValue="true"/>

        <ListPreference
            android:key="pref_default_demod"
            android:title="默认解调模式"
            android:summary="启动时使用的解调模式"
            android:defaultValue="NFM"
            android:dialogTitle="选择解调模式"/>

        <SwitchPreferenceCompat
            android:key="pref_tuner_agc_default"
            android:title="默认射频 AGC"
            android:summary="R82xx 射频增益自动控制；关闭后使用手动增益"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_hardware_agc_default"
            android:title="默认硬件 AGC"
            android:summary="RTL2832U 数字中频自动增益；独立于射频 AGC"
            android:defaultValue="false"/>

        <SeekBarPreference
            android:key="pref_default_gain"
            android:title="默认手动增益"
            android:summary="关闭射频 AGC 时生效：0–49.6 dB，共 29 档"
            android:defaultValue="26"
            app:min="0"
            android:max="28"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_squelch_default"
            android:title="默认静噪门限"
            android:summary="静噪阈值（−120 dBFS 为始终开放）"
            android:defaultValue="100"
            app:min="0"
            android:max="120"
            app:showSeekBarValue="true"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── 9GRadio Hardware Specific ──────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="接收机硬件功能" android:key="cat_v4">

        <SwitchPreferenceCompat
            android:key="pref_bias_tee_default"
            android:title="默认偏置供电"
            android:summary="从天线接口输出 5V，为外置放大器供电"
            android:defaultValue="false"/>

        <ListPreference
            android:key="pref_direct_sampling_default"
            android:title="默认直接采样"
            android:summary="用于 28.8 MHz 以下的短波接收"
            android:entries="@array/direct_sampling_entries"
            android:entryValues="@array/direct_sampling_values"
            android:defaultValue="0"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_hf"
            android:title="自动切换短波直采"
            android:summary="低于 28.8 MHz 时自动启用 Q 支路直采"
            android:defaultValue="true"/>

        <EditTextPreference
            android:key="pref_tcxo_freq"
            android:title="晶振频率"
            android:summary="V4 TCXO 为 28800000 Hz，请按实际硬件设置"
            android:defaultValue="28800000"
            android:inputType="number"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── Display ───────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="频谱与瀑布" android:key="cat_display">

        <ListPreference
            android:key="pref_fft_size"
            android:title="FFT 点数"
            android:summary="越大则频率分辨率越高"
            android:entries="@array/fft_size_entries"
            android:entryValues="@array/fft_size_values"
            android:defaultValue="256"/>

        <ListPreference
            android:key="pref_decimation"
            android:title="FFT 抽取"
            android:summary="抽取后缩小显示带宽，提高频率分辨率"
            android:entries="@array/decimation_entries"
            android:entryValues="@array/decimation_values"
            android:defaultValue="64"
            android:dialogTitle="选择 FFT 抽取倍数"/>

        <ListPreference
            android:key="pref_fft_window"
            android:title="FFT 窗函数"
            android:summary="FFT 前应用于 IQ 的窗函数"
            android:entries="@array/fft_window_entries"
            android:entryValues="@array/fft_window_values"
            android:defaultValue="BLACKMAN_HARRIS"/>

        <SeekBarPreference
            android:key="pref_fft_smoothing"
            android:title="频谱平滑"
            android:summary="越高越平滑，响应也越慢"
            android:defaultValue="30"
            app:min="0"
            android:max="95"
            app:showSeekBarValue="true"/>

        <ListPreference
            android:key="pref_spectrum_theme"
            android:title="频谱配色"
            android:entries="@array/spectrum_theme_entries"
            android:entryValues="@array/spectrum_theme_values"
            android:defaultValue="UI"/>

        <ListPreference
            android:key="pref_waterfall_palette"
            android:title="瀑布配色"
            android:entries="@array/waterfall_palette_entries"
            android:entryValues="@array/waterfall_palette_values"
            android:defaultValue="RAINBOW"/>

        <SeekBarPreference
            android:key="pref_waterfall_speed"
            android:title="瀑布速度"
            android:summary="每秒更新行数"
            android:defaultValue="25"
            app:min="1"
            android:max="60"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_peak_hold"
            android:title="峰值保持"
            android:summary="显示频谱峰值轨迹"
            android:defaultValue="true"/>

        <SeekBarPreference
            android:key="pref_db_min"
            android:title="频谱下限（dBFS）"
            android:summary="显示电平下限的绝对值"
            android:defaultValue="120"
            app:min="60"
            android:max="150"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_db_max"
            android:title="频谱上限（dBFS）"
            android:summary="显示电平上限（0 为满量程）"
            android:defaultValue="0"
            app:min="-40"
            android:max="0"
            app:showSeekBarValue="true"/>

        <!-- ── Advanced spectrum / waterfall controls ───────────────── -->

        <ListPreference
            android:key="pref_frame_averaging"
            android:title="帧平均"
            android:summary="对多帧功率谱取平均，减少随机波动，同时降低更新速度"
            android:entries="@array/frame_avg_entries"
            android:entryValues="@array/frame_avg_values"
            android:defaultValue="1"
            android:dialogTitle="选择帧平均"/>

        <SeekBarPreference
            android:key="pref_peak_decay"
            android:title="峰值保持衰减速度"
            android:summary="峰值轨迹下降速度，数值越高下降越快；单位为 0.001 dB/帧"
            android:defaultValue="2"
            app:min="1"
            android:max="20"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_show_noise_floor"
            android:title="显示噪声底线"
            android:summary="绿色虚线显示每帧估计的噪声底"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_show_peak_annotations"
            android:title="标注峰值频率"
            android:summary="标注最强三个信号的频率与电平"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_crosshair_enabled"
            android:title="长按十字光标"
            android:summary="查看频率与 dBFS"
            android:defaultValue="true"/>

        <SeekBarPreference
            android:key="pref_fill_opacity"
            android:title="频谱填充不透明度"
            android:summary="频谱曲线下方渐变填充的不透明度（0–100%）"
            android:defaultValue="73"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_range"
            android:title="自动电平范围"
            android:summary="自动跟随输入电平，调整显示范围"
            android:defaultValue="false"/>

        <SeekBarPreference
            android:key="pref_waterfall_brightness"
            android:title="瀑布亮度"
            android:summary="偏移瀑布图颜色映射（50 为中性）"
            android:defaultValue="50"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_waterfall_contrast"
            android:title="瀑布对比度"
            android:summary="围绕中点调整对比度（50 为中性，100 为两倍）"
            android:defaultValue="50"
            app:min="5"
            android:max="150"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_waterfall_auto_stretch"
            android:title="瀑布自动电平"
            android:summary="根据信号自动调整瀑布图动态范围"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_waterfall_show_timestamp"
            android:title="瀑布时间刻度"
            android:summary="在瀑布图右侧显示经过时间"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_waterfall_show_tuner_marker"
            android:title="瀑布中心标记"
            android:summary="在硬件中心频率处显示虚线"
            android:defaultValue="true"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── Audio ─────────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="声音控制" android:key="cat_audio">

        <ListPreference
            android:key="pref_audio_output"
            android:title="声音输出"
            android:entries="@array/audio_output_entries"
            android:entryValues="@array/audio_output_values"
            android:defaultValue="speaker"/>

        <ListPreference
            android:key="pref_audio_sink_rate"
            android:title="声音输出采样率"
            android:summary="发送至扬声器或耳机的音频采样率；与 IQ 采样率分别设置"
            android:entries="@array/audio_sink_rate_entries"
            android:entryValues="@array/audio_sink_rate_values"
            android:defaultValue="44100"
            android:dialogTitle="选择声音输出采样率"/>

        <SeekBarPreference
            android:key="pref_default_volume"
            android:title="默认音量"
            android:summary="0–200%"
            android:defaultValue="100"
            app:min="0"
            android:max="200"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_stereo_wfm"
            android:title="WFM 立体声"
            android:summary="与 WFM / WFM Stereo 解调选择同步；无导频时自动回退单声道"
            android:defaultValue="true"/>

        <ListPreference
            android:key="pref_deemph_us"
            android:title="FM 去加重"
            android:summary="50 μs：中国、欧洲等地区；75 μs：北美等地区"
            android:defaultValue="75"
            android:entries="@array/fm_deemphasis_entries"
            android:entryValues="@array/fm_deemphasis_values"/>

        <ListPreference
            android:key="pref_freq_offset"
            android:title="频率偏移"
            android:summary="以固定频偏进行软件微调"
            android:entries="@array/freq_offset_entries"
            android:entryValues="@array/freq_offset_values"
            android:defaultValue="0"/>

        <SwitchPreferenceCompat
            android:key="pref_dc_block"
            android:title="直流抑制"
            android:summary="移除 IQ 直流偏置；出现音频伪影时可关闭"
            android:defaultValue="true"/>

    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── External Decoder ──────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="外部解码器" android:key="cat_external_decoder">

        <SwitchPreferenceCompat
            android:key="pref_external_decoder_enabled"
            android:title="发送音频到外部解码器"
            android:summary="通过 UDP 发送原始 48 kHz 鉴频音频（PCM16LE），供 dsd-neo、DSD-FME 等外部解码器使用"
            android:defaultValue="false"/>

        <EditTextPreference
            android:key="pref_external_decoder_host"
            android:title="目标主机"
            android:summary="运行外部解码器的主机 IP 地址；本机可用 127.0.0.1"
            android:defaultValue="127.0.0.1"/>

        <EditTextPreference
            android:key="pref_external_decoder_port"
            android:title="目标端口"
            android:summary="外部解码器监听的 UDP 端口；dsd-neo/DSD-FME 通常使用 7355"
            android:defaultValue="7355"
            android:inputType="number"/>

    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── Recording ─────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="录制" android:key="cat_recording">

        <ListPreference
            android:key="pref_iq_format"
            android:title="IQ 录制格式"
            android:entries="@array/iq_format_entries"
            android:entryValues="@array/iq_format_values"
            android:defaultValue="RAW_UINT8"/>

        <EditTextPreference
            android:key="pref_recording_path"
            android:title="录制目录"
            android:summary="保存 IQ 与音频的目录"
            android:defaultValue="RTL-SDR/Recordings"
            android:inputType="text"/>

        <SeekBarPreference
            android:key="pref_max_recording_gb"
            android:title="最大录制容量（GB）"
            android:summary="达到容量限制时自动停止"
            android:defaultValue="4"
            app:min="1"
            android:max="64"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_split_recordings"
            android:title="大文件分卷录制"
            android:summary="自动按 2 GB 分卷保存"
            android:defaultValue="true"/>

        <Preference
            android:key="pref_clear_recordings"
            android:title="清空录制文件"
            android:summary="删除本应用保存的全部 IQ 与音频录制"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── Scanner ───────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="扫描默认值" android:key="cat_scanner">

        <SeekBarPreference
            android:key="pref_scan_dwell_ms"
            android:title="频道停留时间（ms）"
            android:summary="在每个频率的停留时间"
            android:defaultValue="200"
            app:min="50"
            android:max="5000"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_scan_resume_s"
            android:title="恢复扫描延迟（s）"
            android:summary="发现信号后的停留时间"
            android:defaultValue="3"
            app:min="1"
            android:max="30"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_scan_squelch"
            android:title="扫描静噪门限（dBFS 绝对值）"
            android:summary="判断扫描命中的电平阈值"
            android:defaultValue="80"
            app:min="20"
            android:max="120"
            app:showSeekBarValue="true"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── Data / Backup ─────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="数据与备份" android:key="cat_data">

        <Preference
            android:key="pref_export_settings"
            android:title="导出设置"
            android:summary="将设置保存为 JSON 文件"/>

        <Preference
            android:key="pref_import_settings"
            android:title="导入设置"
            android:summary="从 JSON 文件恢复有效设置"/>

        <Preference
            android:key="pref_export_memory"
            android:title="导出收藏频道"
            android:summary="将收藏频道保存为 JSON/CSV"/>

        <Preference
            android:key="pref_import_memory"
            android:title="导入收藏频道"
            android:summary="从 JSON/CSV 导入收藏频道"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── About ─────────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="关于" android:key="cat_about">

        <Preference
            android:key="pref_about"
            android:title="9GRadio"
            android:summary=""/>

        <Preference
            android:key="pref_device_info"
            android:title="设备信息"
            android:summary="查看当前接收机信息"/>

        <SwitchPreferenceCompat
            android:key="pref_keep_screen_on"
            android:title="接收时屏幕常亮"
            android:summary="接收时保持屏幕常亮"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_wake_lock"
            android:title="息屏时保持接收"
            android:summary="息屏后保持信号处理运行"
            android:defaultValue="false"/>
    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

    <!-- ─── APRS ──────────────────────────────────────────────────────── -->
    <com.radiosport.ninegradio.ui.RadioPreferenceCategory android:title="APRS" android:key="cat_aprs">

        <SwitchPreferenceCompat
            android:key="pref_aprs_auto_display"
            android:title="自动显示收到的数据包"
            android:summary="收到 APRS 数据包时自动显示 5 秒"
            android:defaultValue="false"/>

    </com.radiosport.ninegradio.ui.RadioPreferenceCategory>

</PreferenceScreen>
