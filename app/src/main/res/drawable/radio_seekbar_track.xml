<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="@dimen/radio_slider_track" android:gravity="center_vertical">
        <shape><solid android:color="?attr/colorOutlineVariant"/><corners android:radius="4dp"/></shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:height="@dimen/radio_slider_track" android:gravity="center_vertical">
        <clip><shape><solid android:color="?attr/colorOutlineVariant"/><corners android:radius="4dp"/></shape></clip>
    </item>
    <item android:id="@android:id/progress" android:height="@dimen/radio_slider_track" android:gravity="center_vertical">
        <clip><shape><solid android:color="?attr/radioSlider"/><corners android:radius="4dp"/></shape></clip>
    </item>
</layer-list>
